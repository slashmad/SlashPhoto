<?xml version="1.0"?>
<ruleset name="SlashPhoto">
	<description>WordPress Coding Standards for SlashPhoto.</description>

	<file>slashphoto.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>templates</file>
	<file>tests</file>
	<file>bin</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.3-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Classes use PSR-4 file names (src/Gallery/PostType.php). -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is allowed. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="slashphoto"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="slashphoto"/>
				<element value="SlashPhoto"/>
			</property>
		</properties>
		<!-- Tests fire core hooks and set core test-suite constants. -->
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Tests use PHPUnit naming and set up WordPress fixtures directly. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
