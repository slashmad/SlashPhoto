{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"phpVersion": "8.4",
	"plugins": [],
	"themes": [
		"https://downloads.wordpress.org/theme/twentytwentyone.zip",
		"https://downloads.wordpress.org/theme/astra.zip"
	],
	"mappings": {
		"wp-content/plugins/slashphoto": "."
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp plugin activate slashphoto && npx wp-env run cli wp rewrite structure '/%postname%/' --hard"
	}
}
