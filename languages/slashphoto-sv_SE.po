msgstr "Galleriets bilduppladdare skickar filer i delar. WordPress mediabibliotek använder serverns vanliga uppladdningsgräns på %s."

#: src/Admin/SettingsPage.php:235
msgid "Image processing with SnapOtter"
msgstr "Bildbehandling med SnapOtter"

#: src/Admin/SettingsPage.php:238
