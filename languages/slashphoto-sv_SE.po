msgid "Optional. Each acceptance is logged with the date and the visitor’s account or email address (SlashPhoto → Visitors)."
msgstr "Valfritt. Varje godkännande loggas med datum och besökarens konto eller e-postadress (SlashPhoto → Besökare)."

#: assets/js/editor-access.js:208
msgid "This is a sub-gallery: the password, client list, secret link, email request, end date and terms of the galleries above it also apply."
msgstr "Det här är ett undergalleri: lösenord, kundlista, hemlig länk, e-postförfrågan, slutdatum och villkor för gallerierna ovanför gäller också."

#: assets/js/editor-access.js:227
msgid "Let clients choose favourites"
msgstr "Låt kunderna välja favoriter"

#: assets/js/editor-access.js:228
msgid "Logged-in clients mark images and send their selection to you. Visitors without an account keep favourites in their own browser only."
msgstr "Inloggade kunder markerar bilder och skickar sitt urval till dig. Besökare utan konto sparar favoriterna bara i sin egen webbläsare."

#: assets/js/editor-access.js:232
msgid "On, as a separate selection"
msgstr "På, som ett separat urval"

#: assets/js/editor-access.js:233
msgid "Off for this gallery"
msgstr "Av för det här galleriet"

#: assets/js/editor-access.js:243
msgid "Maximum number of images"
msgstr "Högsta antal bilder"

#: assets/js/editor-access.js:244
msgid "0 means no limit. Applies to the whole selection, including sub-galleries."
msgstr "0 betyder ingen gräns. Gäller hela urvalet, även undergallerier."

#: assets/js/editor-access.js:251
msgid "Sent selections appear in the “Client selections” box at the bottom of the editor (Meta Boxes). You also get an email."
msgstr "Skickade urval visas i rutan ”Kundernas urval” längst ner i redigeraren (Metarutor). Du får också ett mejl."

#. translators: %s: price list name
#: assets/js/editor-access.js:270
#, js-format
msgid "Default (%s)"
msgstr "Standard (%s)"

#: assets/js/editor-access.js:272
msgid "Default (not for sale)"
msgstr "Standard (inte till salu)"

#: assets/js/editor-access.js:280
msgid "Visitors who can see this gallery can buy downloads and prints of its photos at these prices. Sub-galleries use the same list unless they choose another."
msgstr "Besökare som kan se galleriet kan köpa nedladdningar och prints av bilderna till de här priserna. Undergallerier använder samma lista om de inte väljer en annan."

#: assets/js/editor-upload.js:48
msgid "Upload full-size originals, also RAW, HEIC, TIFF and PSD. SnapOtter makes the display copies; originals are kept private."
msgstr "Ladda upp original i full storlek, även RAW, HEIC, TIFF och PSD. SnapOtter gör visningskopiorna; originalen hålls privata."

#: assets/js/editor-upload.js:49
msgid "Upload full-size originals (JPEG, PNG, WebP, AVIF). Display copies are made automatically; originals are kept private."
msgstr "Ladda upp original i full storlek (JPEG, PNG, WebP, AVIF). Visningskopior görs automatiskt; originalen hålls privata."

#: assets/js/editor-upload.js:65
msgid "Choose files…"
msgstr "Välj filer…"

#. translators: %d: number of images
#: assets/js/editor-upload.js:88
#, js-format
msgid "%d image added. It shows on the gallery page."
msgid_plural "%d images added. They show on the gallery page."
msgstr[0] "%d bild har lagts till. Den visas på gallerisidan."
msgstr[1] "%d bilder har lagts till. De visas på gallerisidan."

#. translators: %s: file name
#: assets/js/uploader.js:88
#, js-format
msgid "%s: this file type cannot be added."
msgstr "%s: den här filtypen kan inte läggas till."

#: assets/js/uploader.js:95
msgid "Upload failed."
msgstr "Uppladdningen misslyckades."

#: assets/js/uploader.js:105
msgid "Added"
msgstr "Tillagd"

#: assets/js/uploader.js:108
msgid "Making the display copy…"
msgstr "Gör visningskopian…"

#. translators: %d: percentage uploaded
#: assets/js/uploader.js:112
#, js-format
msgid "Uploading %d%%"
msgstr "Laddar upp %d%%"

#: assets/js/uploader.js:114
msgid "Waiting"
msgstr "Väntar"

